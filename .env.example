# ─── 조달청 API 설정 ──────────────────────────────────────────────
# 공공데이터포털(data.go.kr) 또는 나라장터에서 발급받은 API 키
PROCUREMENT_API_KEY=여기에_조달청_API_키_입력

# API 엔드포인트 URL (기본: 나라장터 입찰공고 API)
# 다른 API를 사용할 경우 이 값을 변경하세요
PROCUREMENT_API_URL=http://apis.data.go.kr/1230000/BidPublicInfoService04/getBidPblancListInfoServc

# 한 번에 가져올 공고 수 (최대 100)
API_PAGE_SIZE=100

# ─── Claude API 설정 ──────────────────────────────────────────────
ANTHROPIC_API_KEY=여기에_Anthropic_API_키_입력

# ─── 이메일 발송 설정 ────────────────────────────────────────
# 발신 Gmail 주소
EMAIL_SENDER=your.gmail@gmail.com
# Gmail 앱 비밀번호 (16자리, 구글 2단계 인증 후 생성)
# 생성 방법: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
# 수신 이메일
EMAIL_RECIPIENT=seunkgyo.lee@barunlaw.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ─── 스케줄 설정 ─────────────────────────────────────────────────
# 실행 주기 (일 단위, 기본 3일)
INTERVAL_DAYS=3

# 상태 파일 경로 (마지막 실행 시각 저장)
STATE_FILE=procurement_agent/state.json

# 리포트 저장 디렉토리
OUTPUT_DIR=output/reports
